            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Fornecedor f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Telefone</td>
                <td>@f.Cnpj</td>
