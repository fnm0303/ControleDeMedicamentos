@model Fornecedor

@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Editar Fornecedor";
}

<form action="/Fornecedor/Editar/@Model.Id" method="post">
    <div class="col-4">
        <label for="nome"> Nome </label>
        <input class="form-control bg-light" id="nome" name="nome" type="text" value="@Model.Nome">
    </div>
    <div class="row g-3 align-items-center">
        <div class="col-auto">
            <label for="telefone"> Telefone </label>
            <input class="form-control bg-light" id="telefone" name="telefone" type="text" value="@Model.Telefone">
        </div>
        <div class="col-auto">
            <label for="cnpj"> CNPJ </label>
            <input class="form-control bg-light" id="cnpj" name="cnpj" type="text" value="@Model.Cnpj">
        </div>
    </div>
    <div class="d-flex gap-3 mt-4">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i>
            Confirmar Edição
        </button>
        <a class="btn btn-primary" href="/Fornecedor/Listar">
            <i class="bi bi-arrow-return-left"></i>
            Voltar para a Listagem
        </a>
    </div>

</form>

