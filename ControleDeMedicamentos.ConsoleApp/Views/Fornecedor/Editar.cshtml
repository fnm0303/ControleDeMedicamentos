@model Fornecedor

<h2>Controle de Medicamentos</h2>

<hr />
<a href="/">Início</a> /
<a href="/Fornecedor/Listar">Fornecedores</a> / @*Link*@
<a href="/Medicamento/Listar">Medicamentos</a>
<hr />

<h1>Editar Fornecedor</h1>

<form action="/Fornecedor/Editar/@Model.Id" method="post">
    <div>
        <label for="nome"> Nome </label>
        <br />
        <input id="nome" name="nome" type="text" value="@Model.Nome">
    </div>
    <div>
        <label for="telefone"> Telefone </label>
        <br />
        <input id="telefone" name="telefone" type="text" value="@Model.Telefone">
    </div>
    <div>
        <label for="cnpj"> CNPJ </label>
        <br />
        <input id="cnpj" name="cnpj" type="text" value="@Model.Cnpj">
    </div>
    <button type="submit">Confirmar Edição</button>
</form>

<p>
    <a href="/Fornecedor/Listar">Voltar para a Listagem</a>
</p>