@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Cadastro de Fornecedor";
}

<form action="Cadastrar" method="post">
    <div class="col-4">
        <label for="nome"> Nome </label>
        <input id="nome" name="nome" type="text" class="form-control bg-light">
    </div>
    <div class="row g-3 align-items-center">
        <div class="col-auto">
            <label for="telefone" class="col-form-label">Telefone</label>
            <input id="telefone" name="telefone" type="text" class="form-control bg-light">
            <span class="form-text">(xx) xxxxx-xxxx</span>
        </div>
        <div class="col-auto">
            <label for="cnpj" class="col-form-label"> CNPJ </label>
            <input id="cnpj" name="cnpj" type="text" class="form-control bg-light">
            <span class="form-text">xx.xxx.xxx/xxxx-xx</span>
        </div>
    </div>
    <br />
</form>

<div class="d-flex gap-3 mt-4">
    <button type="submit" class="btn btn-success">Cadastrar</button>
    <a class="btn btn-primary" href="/Fornecedor/Listar">Voltar para a Listagem</a>
</div>
