@model ExcluirFuncionarioViewModel

@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Excluir Funcionário";
}

<form asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <p>
        Você deseja realmente excluir o registro @Model.Nome? Esta ação é irreversível.
    </p>
    <button type="submit" class="btn btn-success">Confirmar Exclusão</button>
</form>

<p>
    <a asp-action="Listar">Voltar para a Listagem</a>
</p>