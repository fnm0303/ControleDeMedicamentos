@model EditarFuncionarioViewModel
@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Editar Funcionário";
}

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <div class="col-4">
        <label asp-for="Nome"></label>
        <input class="form-control bg-light" asp-for="Nome" type="text">
        <span class="text-danger" asp-validation-for="Nome"></span>
    </div>
    <div class="row g-3 align-items-center">
        <div class="col-3">
            <label asp-for="Telefone"></label>
            <input class="form-control bg-light" asp-for="Telefone" type="text">
            <span class="text-danger" asp-validation-for="Telefone"></span>
        </div>
        <div class="col-3">
            <label asp-for="CPF"></label>
            <input class="form-control bg-light" asp-for="CPF" type="text">
            <span class="text-danger" asp-validation-for="CPF"></span>
        </div>
    </div>
    <div class="d-flex gap-3 mt-4">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i>
            Confirmar Edição
        </button>
        <a class="btn btn-primary" href="/Funcionario/Listar">
            <i class="bi bi-arrow-return-left"></i>
            Voltar para a Listagem
        </a>
    </div>

</form>

