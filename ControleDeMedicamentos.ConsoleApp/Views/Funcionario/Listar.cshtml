@model List<ListarFuncionarioViewModel>

@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Listagem de Funcionários";
}

<p>
    <a class="btn btn-success" asp-action="Cadastrar">Cadastrar Funcionário</a>
</p>

<table class="table table-success table-striped">
    <thead> @*cabeçalho*@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody> @* Corpo *@
        @foreach (ListarFuncionarioViewModel f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Telefone</td>
                <td>
                    <a class="btn btn-sm btn-outline-success" href="Editar/@f.Id">Editar</a>
                    <span> | </span>
                    <a class="btn btn-sm btn-outline-danger" href="Excluir/@f.Id">Excluir</a>
                </td>
            </tr>
        }

    </tbody>
</table>