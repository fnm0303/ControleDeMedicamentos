@model List<ListarFuncionarioViewModel>

<h2>Controle de Medicamentos</h2>

<hr />
<a asp-controller="Home" asp-action="Index">Início</a> /
<a asp-controller="Fornecedor" asp-action="Listar">Fornecedores</a> / @*Link*@
<a asp-controller="Medicamento" asp-action="Listar">Medicamentos</a> /
<a asp-controller="Funcionario" asp-action="Listar">Funcionários</a> /
<a asp-controller="Paciente" asp-action="Listar">Pacientes</a> /
<hr />

<h1>Listagem de Funcionários</h1>

<p>
    <a asp-action="Cadastrar">Cadastrar Funcionário</a>
</p>

<table>
    <thead> @*cabeçalho*@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody> @* Corpo *@
        @foreach (ListarFuncionarioViewModel f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Telefone</td>
                <td>
                    <a href="Editar/@f.Id">Editar</a>
                    <span> | </span>
                    <a href="Excluir/@f.Id">Excluir</a>
                    <span> | </span>
                </td>
            </tr>
        }

    </tbody>
</table>