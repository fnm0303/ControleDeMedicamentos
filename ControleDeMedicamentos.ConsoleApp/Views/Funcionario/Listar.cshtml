@model List<ListarFuncionarioViewModel>

@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Página Inicial";
}

<h1>Listagem de Funcionários</h1>

<p>
    <a asp-action="Cadastrar">Cadastrar Funcionário</a>
</p>

<table>
    <thead> @*cabeçalho*@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody> @* Corpo *@
        @foreach (ListarFuncionarioViewModel f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Telefone</td>
                <td>
                    <a href="Editar/@f.Id">Editar</a>
                    <span> | </span>
                    <a href="Excluir/@f.Id">Excluir</a>
                    <span> | </span>
                </td>
            </tr>
        }

    </tbody>
</table>