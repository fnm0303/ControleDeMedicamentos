@model CadastrarFuncionarioViewModel
@{
    Layout = "_Layout"; //não precisa passar todo o caminho
}

<h1>Cadastro de Funcionário</h1>

<form asp-action="Cadastrar" method="post">
    <div>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" type="text">
    </div>
    <br />
    <div>
        <label asp-for="Telefone"></label>
        <input asp-for="Telefone" type="text">
    </div>
    <br />
    <div>
        <label asp-for="CPF"></label>
        <input asp-for="CPF" type="text">
        <br />
    </div>
    <br />
    <button type="submit">Cadastrar</button>
</form>

<p>
    <a asp-action="Listar">Voltar para a Listagem</a>
</p>