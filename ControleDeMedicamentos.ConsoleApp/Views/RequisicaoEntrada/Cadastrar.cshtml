@using ControleDeMedicamentos.ConsoleApp.ModuloRequisicoes
@model CadastrarRequisicaoEntradaViewModel

@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Cadastro de Requisição de Entrada";
}

<form asp-action="Cadastrar" method="post">
    <div class="col-6">
        <label asp-for="MedicamentoId">Digite o ID do Medicamento</label>
        <input asp-for="MedicamentoId" type="Text" class="form-control bg-light">
    </div>
    <div class="row g-3 align-items-center">
        <div class="col-auto">
            <label asp-for="Quantidade" class="col-form-label"></label>
            <input asp-for="Quantidade" type="text" class="form-control bg-light">
        </div>
    </div>
    <div class="d-flex gap-3 mt-4">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-person-fill-check"></i>
            Cadastrar
        </button>
        <a class="btn btn-primary" href="/RequisicaoEntrada/Listar">
            <i class="bi bi-arrow-return-left"></i>
            Voltar para a Listagem
        </a>
    </div>
</form>