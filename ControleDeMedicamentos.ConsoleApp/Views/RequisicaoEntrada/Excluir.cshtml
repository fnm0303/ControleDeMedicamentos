@using ControleDeMedicamentos.ConsoleApp.ModuloRequisicoes
@model ExcluirRequisicaoEntradaViewModel
@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Excluir Paciente";
}

<form asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <div class="col-6 alert alert-danger" role="alert">
        Você deseja realmente excluir o registro @Model.Id? Esta ação é irreversível.
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-check-circle"></i>
            Confirmar Exclusão
        </button>

    </div>
</form>
<a class="btn btn-primary" asp-action="Listar">
    <i class="bi bi-arrow-return-left"></i>
    Voltar para a Listagem
</a>