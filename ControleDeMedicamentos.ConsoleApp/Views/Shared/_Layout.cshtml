<body data-bs-theme="light">
    <nav class="navbar navbar-expand-lg bg-primary">
  <div class="container">
    <a class="navbar-brand" href="#">Controle de Medicamentos</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="ms-auto navbar-nav">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" asp-controller="Home" asp-action="Index">Início</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" asp-controller="Fornecedor" asp-action="Listar">Fornecedor</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" asp-controller="Medicamento" asp-action="Listar">Medicamento</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" asp-controller="Funcionário" asp-action="Listar">Funcionário</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" asp-controller="Paciente" asp-action="Listar">Paciente</a>
        </li>
      </ul>
    </div>
  </div>
      </nav>

    <header class="container mt-4">
        <h1>@ViewBag.Titulo</h1>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
</body>

</html>
