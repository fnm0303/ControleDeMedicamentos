@using ControleDeMedicamentos.ConsoleApp.ModuloPaciente
@model EditarPacienteViewModel
@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Editar Paciente";
}

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <div class="col-6">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" type="text" class="form-control bg-light">
    </div>
    <div class="row g-3 align-items-center">
        <div class="col-auto">
            <label class="col-form-label" asp-for="Telefone"></label>
            <input asp-for="Telefone" type="text" class="form-control bg-light">
        </div>
        <div class="col-auto">
            <label class="col-form-label" asp-for="CartaoSus"></label>
            <input asp-for="CartaoSus" type="text" class="form-control bg-light">
        </div>
        <div class="col-auto">
            <label class="col-form-label" asp-for="CPF"></label>
            <input asp-for="CPF" type="text" class="form-control bg-light">
        </div>
    </div>
    <div class="d-flex gap-3 mt-4">
        <button class="btn btn-success" type="submit">Confirmar Edição</button>
        <a class="btn btn-primary" asp-action="Listar">Voltar para a Listagem</a>
    </div>
</form>
