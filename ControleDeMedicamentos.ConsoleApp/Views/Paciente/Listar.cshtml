@using ControleDeMedicamentos.ConsoleApp.ModuloPaciente
@model List<ListarPacienteViewModel>

<h2>Controle de Medicamentos</h2>

<hr />
<a asp-controller="Home" asp-action="Index">Início</a> /
<a asp-controller="Fornecedor" asp-action="Listar">Fornecedores</a> / @*Link*@
<a asp-controller="Medicamento" asp-action="Listar">Medicamentos</a> /
<a asp-controller="Funcionario" asp-action="Listar">Funcionários</a> /
<a asp-controller="Paciente" asp-action="Listar">Pacientes</a> /
<hr />

<h1>Listagem de Pacientes</h1>

<p>
    <a href="Cadastrar">Cadastrar Paciente</a>
</p>

<table>
    <thead> @*cabeçalho*@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th>CartaoSus</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody> @* Corpo *@
        @foreach (ListarPacienteViewModel p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nome</td>
                <td>@p.Telefone</td>
                <td>@p.CartaoSus</td>
                <td>
                    <a href="Editar/@p.Id">Editar</a>
                    <span> | </span>
                    <a href="Excluir/@p.Id">Excluir</a>
                    <span> | </span>
                </td>
            </tr>
        }

    </tbody>
</table>