@using ControleDeMedicamentos.ConsoleApp.ModuloPaciente
@model CadastrarPacienteViewModel
@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Cadastro de Paciente";
}

<form asp-action="Cadastrar" method="post">
    <div class="col-6">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" type="text" class="form-control bg-light">
    </div>
    <div class="row g-3 align-items-center">
        <div class="col-auto">
            <label asp-for="Telefone" class="col-form-label"></label>
            <input asp-for="Telefone" type="text" class="form-control bg-light">
            <span class="form-text">(xx) xxxxx-xxxx</span>
        </div>
        <div class="col-auto">
            <label asp-for="CartaoSus" class="col-form-label">Cartão SUS</label>
            <input asp-for="CartaoSus" type="text" class="form-control bg-light">
            <span class="form-text">15 caracteres numéricos</span>
        </div>
        <div class="col-auto">
            <label asp-for="CPF" class="col-form-label"></label>
            <input asp-for="CPF" type="text" class="form-control bg-light">
            <span class="form-text">xxx.xxx.xxx-xx</span>
        </div>
    </div>
    <div class="d-flex gap-3 mt-4">
        <button type="submit" class="btn btn-success">Cadastrar</button>
        <a class="btn btn-primary" href="/Paciente/Listar">Voltar para a Listagem</a>
    </div>
</form>

