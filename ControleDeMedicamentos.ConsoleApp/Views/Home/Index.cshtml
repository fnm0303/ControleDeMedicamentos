@{
    Layout = "_Layout"; //não precisa passar todo o caminho

    ViewBag.Titulo = "Página Inicial";
}

<div class="row align-items-center my-4">
    <!-- Coluna de Texto/Boas-vindas -->
    <div class="col-lg-6 mb-4 mb-lg-0">
        <h2 class="display-6">Bem-vindo ao Sistema de Controle de Medicamentos</h2>
        <p class="lead">
            Gerencie fornecedores, estoque de medicamentos, funcionários e pacientes de forma centralizada e eficiente.
        </p>
    </div>

    <!-- Coluna da Imagem -->
    <div class="col-lg-6 text-center">
        <img src="~/images/inicial.png" asp-asp-append-version="true" class="img-fluid rounded"
             alt="Painel do Controle de Medicamentos">
    </div>
</div>

