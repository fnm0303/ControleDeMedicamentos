@model List<Medicamento>

@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Listagem de Medicamentos";
}

<p>
    <a class="btn btn-success" href="Cadastrar">
        <i class="bi bi-clipboard-check"></i>
        Cadastrar Medicamento
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mt-4" role="alert">
        Não há nenhum medicamento cadastrado.
    </div>
}

else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-3">
        @foreach (Medicamento m in Model)
        {
            <div class="col">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4>@m.Nome</h4>
                            <span class="badge text-bg-secondary">@m.Id</span>
                        </div>
                        <dl class="row mb-2">
                            <dt class="col-sm-6">Fornecedor</dt>
                            <dd class="col-sm-8">@m.Fornecedor.Nome</dd>
                            <dt class="col-sm-5">Descrição</dt>
                            <dd class="col-sm-8">@m.Descricao</dd>
                            <dt class="col-sm-5">Estoque</dt>
                            <dd class="col-sm-8">@m.QuantidadeEmEstoque</dd>
                        </dl>
                        <div class="d-flex gap-1 justify-content-end mt-auto">
                            <a class="btn btn-sm btn-outline-success" title="Editar" href="Editar/@m.Id">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger" title="Excluir" href="Excluir/@m.Id">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

