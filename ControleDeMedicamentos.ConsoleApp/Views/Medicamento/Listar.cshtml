@model List<Medicamento>

@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Listagem de Medicamentos";
}

<p>
    <a class="btn btn-success" href="Cadastrar">Cadastrar Medicamento</a>
</p>

<table class="table table-success table-striped">
    <thead> @*cabeçalho*@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Fornecedor</th>
            <th>Descrição</th>
            <th>Estoque</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody> @* Corpo *@
        @foreach (Medicamento m in Model)
        {
            <tr>
                <td>@m.Id</td>
                <td>@m.Nome</td>
                <td>@m.Fornecedor.Nome</td>
                <td>@m.Descricao</td>
                <td>@m.QuantidadeEmEstoque</td>
                <td>
                    <a class="btn btn-sm btn-outline-success" href="Editar/@m.Id">Editar</a>
                    <span> | </span>
                    <a class="btn btn-sm btn-outline-danger" href="Excluir/@m.Id">Excluir</a>
                </td>
            </tr>

        }

    </tbody>
</table>