@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Cadastro de Medicamento";
}

<form action="/Medicamento/Cadastrar" method="post">
    <div class="col-auto">
        <label for="nome"> Nome </label>
        <input id="nome" name="nome" type="text" class="form-control bg-light">
    </div>
    <div class="col-auto">
        <label for="descricao"> Descrição </label>
        <textarea id="descricao" name="descricao" class="form-control bg-light"></textarea>
    </div>
    <div>
        <label for="fornecedorId"> Fornecedor </label>
        <select class="form-select bg-light" input id="fornecedorId" name="fornecedorId">
            <option value="" disabled selected>Selecione um fornecedor</option>
            @foreach (Fornecedor f in ViewBag.Fornecedores)
            {
                <option value="@f.Id">@f.Nome</option>
            }
        </select>
    </div>
    <br />
    <button type="submit" class="btn btn-success">Cadastrar</button>
</form>

<p>
    <a href="/Medicamento/Listar">Voltar para a Listagem</a>
</p>