<h2>Controle de Medicamentos</h2>

<hr />
<a asp-controller="Home" asp-action="Index">Início</a> /
<a asp-controller="Fornecedor" asp-action="Listar">Fornecedores</a> / @*Link*@
<a asp-controller="Medicamento" asp-action="Listar">Medicamentos</a> /
<a asp-controller="Funcionario" asp-action="Listar">Funcionários</a> /
<a asp-controller="Paciente" asp-action="Listar">Pacientes</a> /
<hr />

<h1>Cadastro de Medicamento</h1>

<form action="/Medicamento/Cadastrar" method="post">
    <div>
        <label for="nome"> Nome </label>
        <br />
        <input id="nome" name="nome" type="text">
    </div>
    <div>
        <label for="descricao"> Descrição </label>
        <br />
        <textarea id="descricao" name="descricao"></textarea>
    </div>
    <div>
        <label for="fornecedorId"> Fornecedor </label>
        <br />
        <select input id="fornecedorId" name="fornecedorId">
            @foreach (Fornecedor f in ViewBag.Fornecedores)
            {
                <option value="@f.Id">@f.Nome</option>
            }
        </select>
    </div>
    <br />
    <button type="submit">Cadastrar</button>
</form>

<p>
    <a href="/Medicamento/Listar">Voltar para a Listagem</a>
</p>