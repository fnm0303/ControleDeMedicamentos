@model Medicamento;

@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Editar Medicamento";
}

<form action="/Medicamento/Editar/@Model.Id" method="post">
    <div class="col-6">
        <label for="nome"> Nome </label>
        <input class="form-control bg-light" id="nome" name="nome" type="text" value="@Model.Nome">
    </div>
    <div class="col-6">
        <label for="descricao"> Descrição </label>
        <textarea class="form-control bg-light" id="descricao" name="descricao">@Model.Descricao</textarea>
    </div>
    <div class="col-6">
        <label for="fornecedorId">Fornecedor</label>
        <select class="form-select bg-light" id="fornecedorId" name="fornecedorId">
            @foreach (Fornecedor f in ViewBag.Fornecedores)
            {
                if (f.Id == Model.Fornecedor.Id)
                {
                    <option value="@f.Id" selected>@f.Nome</option>
                }
                else
                {
                    <option value="@f.Id">@f.Nome</option>
                }
            }
        </select>
    </div>
    <div class="d-flex gap-3 mt-4">
        <button type="submit" class="btn btn-success">Confirmar Edição</button>
        <a class="btn btn-primary" href="/Medicamento/Listar">Voltar para a Listagem</a>
    </div>
</form>

