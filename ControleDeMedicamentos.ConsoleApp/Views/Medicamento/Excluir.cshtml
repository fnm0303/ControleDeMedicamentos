@using ControleDeMedicamentos.ConsoleApp.ModuloFornecedores
@using ControleDeMedicamentos.ConsoleApp.ModuloMedicamentos
@model Medicamento;

<h2>Controle de Medicamentos</h2>

<hr />
<a href="/">Início</a> /
<a href="/Fornecedor/Listar">Fornecedores</a> / @*Link*@
<a href="/Medicamento/Listar">Medicamentos</a>
<hr />

<h1>Exclusão de Medicamento</h1>

<form action="/Medicamento/Excluir/@Model.Id" method="post">
    <p>
        Você deseja realmente excluir o registro @Model.Nome? Esta ação é irreversível.
    </p>
    <button type="submit">Confirmar Exclusão</button>
</form>

<p>
    <a href="/Medicamento/Listar">Voltar para a Listagem</a>
</p>