@model Medicamento;

@{
    Layout = "_Layout"; //não precisa passar todo o caminho
    ViewBag.Titulo = "Exclusão de Medicamento";
}

<form action="/Medicamento/Excluir/@Model.Id" method="post">
    <p>
        Você deseja realmente excluir o registro @Model.Nome? Esta ação é irreversível.
    </p>
    <button type="submit">Confirmar Exclusão</button>
</form>

<p>
    <a href="/Medicamento/Listar">Voltar para a Listagem</a>
</p>